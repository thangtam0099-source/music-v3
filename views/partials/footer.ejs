<footer class="app-site-footer">
  <div class="footer-inner-content">
    <div class="footer-brand-column">
      <div class="footer-logo">
        <% if (settings && settings.logo) { %>
          <img src="<%= settings.logo %>" alt="Tâm Music" class="footer-logo-img">
        <% } else { %>
          <span class="footer-logo-icon">🎵</span>
        <% } %>
        <span class="footer-logo-title"><%= settings && settings.footer_title ? settings.footer_title : 'Tâm Music' %></span>
      </div>
      <% if (settings && settings.footer_text) { %>
        <p class="footer-description"><%= settings.footer_text %></p>
      <% } else { %>
        <p class="footer-description">Thưởng thức âm nhạc mọi lúc mọi nơi với âm thanh chất lượng và giao diện tối ưu.</p>
      <% } %>
    </div>

    <div class="footer-links-column">
      <span class="footer-col-heading">Điều hướng</span>
      <ul class="footer-links-list">
        <li><a href="/">Trang chủ</a></li>
        <li><a href="/albums">Album tuyển chọn</a></li>
        <li><a href="/playlists">Playlist cá nhân</a></li>
      </ul>
    </div>

    <% if (settings && (settings.facebook_url || settings.messenger_url || settings.zalo_url)) { %>
      <div class="footer-social-column">
        <span class="footer-col-heading">Kết nối</span>
        <div class="footer-social-badges">
          <% if (settings.facebook_url) { %>
            <a href="<%= settings.facebook_url %>" target="_blank" rel="noopener noreferrer" class="social-badge-link" aria-label="Facebook Tâm Music">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
              <span>Facebook</span>
            </a>
          <% } %>
          <% if (settings.messenger_url) { %>
            <a href="<%= settings.messenger_url %>" target="_blank" rel="noopener noreferrer" class="social-badge-link" aria-label="Messenger">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 0C5.373 0 0 4.974 0 11.111c0 3.498 1.744 6.614 4.469 8.654V24l4.088-2.242c1.09.302 2.246.464 3.443.464 6.627 0 12-4.975 12-11.111C24 4.974 18.627 0 12 0zm1.191 14.963l-3.056-3.26-5.963 3.26 6.559-6.963 3.13 3.259 5.89-3.259-6.56 6.963z"/>
              </svg>
              <span>Messenger</span>
            </a>
          <% } %>
          <% if (settings.zalo_url) { %>
            <a href="<%= settings.zalo_url %>" target="_blank" rel="noopener noreferrer" class="social-badge-link" aria-label="Zalo">
              <span class="zalo-text-badge">Zalo</span>
            </a>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>

  <div class="footer-bottom-bar">
    <div class="footer-copyright-text">
      <%= settings && settings.footer_copyright ? settings.footer_copyright : '© ' + new Date().getFullYear() + ' Tâm Music. Bản quyền thuộc về Tâm Music.' %>
    </div>
    <div class="footer-signature">
      Trải nghiệm âm nhạc hiện đại & tinh tế.
    </div>
  </div>
</footer>
