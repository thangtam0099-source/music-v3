<aside class="app-sidebar" id="appSidebar" aria-label="Thanh điều hướng chính">
  <div class="sidebar-header">
    <a href="/" class="sidebar-brand" aria-label="Tâm Music - Về trang chủ">
      <% if (settings && settings.logo) { %>
        <img class="brand-logo-img" src="<%= settings.logo %>" alt="Tâm Music Logo">
      <% } else { %>
        <div class="brand-logo-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 18V5l12-2v13"></path>
            <circle cx="6" cy="18" r="3"></circle>
            <circle cx="18" cy="16" r="3"></circle>
          </svg>
        </div>
      <% } %>
      <div class="brand-text">
        <span class="brand-name">Tâm Music</span>
        <span class="brand-tag">Streaming</span>
      </div>
    </a>
    <button class="sidebar-close-btn" id="sidebarCloseBtn" type="button" aria-label="Đóng thanh điều hướng">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <nav class="sidebar-nav">
    <div class="sidebar-section-title">Menu chính</div>
    <ul class="nav-list">
      <li class="nav-item">
        <a href="/" class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'home' ? 'active' : '' %>" data-nav="home">
          <span class="nav-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
          </span>
          <span class="nav-label">Trang chủ</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/albums" class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'albums' ? 'active' : '' %>" data-nav="albums">
          <span class="nav-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10"></path>
            </svg>
          </span>
          <span class="nav-label">Album</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/playlists" class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'playlists' ? 'active' : '' %>" data-nav="playlists">
          <span class="nav-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m16 6 4 14"></path>
              <path d="M12 6v14"></path>
              <path d="M8 8v12"></path>
              <path d="M4 4v16"></path>
            </svg>
          </span>
          <span class="nav-label">Playlist</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/favorites" class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'favorites' ? 'active' : '' %>" id="likedSongsNavBtn" data-nav="favorites">
          <span class="nav-icon nav-icon-heart">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
            </svg>
          </span>
          <span class="nav-label">Bài hát yêu thích</span>
          <span class="nav-badge" id="likedCountBadge">0</span>
        </a>
      </li>
    </ul>

    <div class="sidebar-section-title">Thư viện của bạn</div>
    <div class="sidebar-library-box">
      <% if (user) { %>
        <div class="library-user-quick">
          <p class="library-subtitle">Chào mừng, <strong><%= user.username %></strong>!</p>
          <a href="/playlists" class="btn btn-sm btn-outline-green" style="width: 100%; justify-content: center; margin-top: 8px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 14px; height: 14px;">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Quản lý Playlist
          </a>
        </div>
      <% } else { %>
        <div class="library-guest-cta">
          <p class="library-cta-text">Đăng nhập để tạo và lưu playlist yêu thích của riêng bạn.</p>
          <div class="library-cta-buttons">
            <a href="/login" class="btn btn-sm btn-primary">Đăng nhập</a>
            <a href="/register" class="btn btn-sm btn-ghost">Đăng ký</a>
          </div>
        </div>
      <% } %>
    </div>

    <% if (user && user.role === 'admin') { %>
      <div class="sidebar-section-title">Quản trị</div>
      <ul class="nav-list">
        <li class="nav-item">
          <a href="/admin" class="nav-link admin-nav-link">
            <span class="nav-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                <path d="M3 9h18"></path>
                <path d="M9 21V9"></path>
              </svg>
            </span>
            <span class="nav-label">Trang Quản Trị</span>
          </a>
        </li>
      </ul>
    <% } %>
  </nav>

  <div class="sidebar-footer">
    <% if (user) { %>
      <div class="user-status-card">
        <div class="user-avatar-circle">
          <%= user.username.charAt(0).toUpperCase() %>
        </div>
        <div class="user-details">
          <span class="user-name" title="<%= user.username %>"><%= user.username %></span>
          <span class="user-role-tag"><%= user.role === 'admin' ? 'Quản trị viên' : 'Thành viên' %></span>
        </div>
        <a href="/logout" class="user-logout-btn" title="Đăng xuất" aria-label="Đăng xuất">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
        </a>
      </div>
    <% } else { %>
      <div class="sidebar-auth-row">
        <a href="/login" class="btn btn-sm btn-outline-white" style="flex:1; justify-content:center;">Đăng nhập</a>
        <a href="/register" class="btn btn-sm btn-primary" style="flex:1; justify-content:center;">Đăng ký</a>
      </div>
    <% } %>
  </div>
</aside>
<div class="sidebar-backdrop" id="sidebarBackdrop"></div>
