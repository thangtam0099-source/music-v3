<header class="app-header" id="appHeader">
  <div class="header-left">
    <button type="button" class="sidebar-toggle-btn" id="sidebarOpenBtn" aria-label="Mở menu điều hướng">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" x2="20" y1="12" y2="12"></line>
        <line x1="4" x2="20" y1="6" y2="6"></line>
        <line x1="4" x2="20" y1="18" y2="18"></line>
      </svg>
    </button>

    <a href="/" class="header-mobile-brand" aria-label="Tâm Music">
      <% if (settings && settings.logo) { %>
        <img src="<%= settings.logo %>" alt="Logo" class="header-mobile-logo">
      <% } else { %>
        <span class="header-mobile-icon">🎵</span>
      <% } %>
      <span class="header-mobile-name">Tâm Music</span>
    </a>

    <div class="history-nav-group" aria-label="Lịch sử trang">
      <button type="button" class="history-btn" id="histBackBtn" onclick="window.history.back()" title="Quay lại" aria-label="Quay lại">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button type="button" class="history-btn" id="histForwardBtn" onclick="window.history.forward()" title="Tiến tới" aria-label="Tiến tới">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>

  <div class="header-center">
    <form class="search-form" id="searchForm" action="/" method="GET" autocomplete="off" role="search">
      <% if (typeof sort !== 'undefined' && sort !== 'newest') { %>
        <input type="hidden" name="sort" value="<%= sort %>">
      <% } %>
      <div class="search-field-container">
        <span class="search-leading-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </span>
        <input
          id="searchInput"
          type="search"
          name="q"
          value="<%= typeof q !== 'undefined' ? q : '' %>"
          placeholder="Tìm bài hát, ca sĩ..."
          role="combobox"
          aria-autocomplete="list"
          aria-controls="searchSuggestions"
          aria-expanded="false"
          aria-label="Tìm kiếm nhạc"
        >
        <button type="button" class="search-clear-btn" id="searchClearBtn" title="Xóa tìm kiếm" aria-label="Xóa nội dung tìm kiếm" style="display: none;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
        <kbd class="search-kbd-shortcut" title="Phím tắt: / hoặc Ctrl+K">/</kbd>
      </div>

      <!-- Autocomplete Dropdown -->
      <div id="searchSuggestions" class="search-suggestions-popover" role="listbox" aria-label="Gợi ý tìm kiếm">
        <div class="suggestions-header">
          <span>Gợi ý tìm kiếm nhanh</span>
          <span class="suggestions-hint">Nhấn Enter để nghe</span>
        </div>
        <div class="suggestions-list" id="suggestionsList"></div>
      </div>
    </form>
  </div>

  <div class="header-right">
    <% if (user) { %>
      <div class="header-user-menu">
        <button type="button" class="header-user-pill" id="headerUserBtn" aria-haspopup="true" aria-expanded="false">
          <span class="user-avatar-small"><%= user.username.charAt(0).toUpperCase() %></span>
          <span class="user-name-text"><%= user.username %></span>
          <svg class="chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div class="header-dropdown-menu" id="headerUserDropdown" role="menu">
          <div class="dropdown-header">
            <strong><%= user.username %></strong>
            <span><%= user.role === 'admin' ? 'Quản trị viên' : 'Thành viên' %></span>
          </div>
          <div class="dropdown-divider"></div>
          <% if (user.role === 'admin') { %>
            <a href="/admin" class="dropdown-item" role="menuitem">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                <path d="M3 9h18"></path>
                <path d="M9 21V9"></path>
              </svg>
              Trang quản trị
            </a>
          <% } %>
          <a href="/playlists" class="dropdown-item" role="menuitem">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m16 6 4 14"></path>
              <path d="M12 6v14"></path>
              <path d="M8 8v12"></path>
              <path d="M4 4v16"></path>
            </svg>
            Playlist của tôi
          </a>
          <div class="dropdown-divider"></div>
          <a href="/logout" class="dropdown-item dropdown-item-danger" role="menuitem">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            Đăng xuất
          </a>
        </div>
      </div>
    <% } else { %>
      <div class="header-auth-buttons">
        <a href="/login" class="btn btn-sm btn-ghost header-login-ghost">Đăng nhập</a>
        <a href="/register" class="btn btn-sm btn-primary header-register-btn">Đăng ký</a>
      </div>
    <% } %>
  </div>
</header>
