<!DOCTYPE html>
<html lang="vi" data-theme="dark">
<head>
  <%- include('partials/head') %>
  <title><%= playlist.name %> — Playlist | Tâm Music</title>
</head>
<body class="app-body" <% if (settings && settings.background) { %> style="--custom-bg: url('<%= settings.background %>');" <% } %>>

  <div class="app-layout">
    <%- include('partials/sidebar', { user, settings, activeNav: 'playlists' }) %>

    <div class="app-main-viewport">
      <%- include('partials/header', { user, settings }) %>

      <main class="main-content" id="mainContent" role="main">

        <!-- Breadcrumb -->
        <nav class="app-breadcrumb" aria-label="Đường dẫn trang">
          <a href="/playlists">Playlist của tôi</a>
          <span class="sep">/</span>
          <span class="current"><%= playlist.name %></span>
        </nav>

        <!-- Playlist Hero Section -->
        <div class="detail-hero-card">
          <div class="detail-hero-cover-wrap">
            <% const heroImg = songs.find(s => s.image)?.image; %>
            <% if (heroImg) { %>
              <img class="detail-hero-cover" src="<%= heroImg %>" alt="<%= playlist.name %>">
            <% } else { %>
              <div class="detail-hero-placeholder">🎵</div>
            <% } %>
          </div>

          <div class="detail-hero-info">
            <span class="detail-type-badge">Playlist</span>
            <h1 class="detail-title"><%= playlist.name %></h1>
            <div class="detail-meta-row">
              <span class="detail-stat"><strong><%= songs.length %></strong> bài hát</span>
              <span class="meta-dot">·</span>
              <span class="detail-stat">Tạo bởi <strong><%= user.username %></strong></span>
            </div>

            <div class="detail-action-buttons">
              <% if (songs.length > 0) { %>
                <button type="button" class="btn btn-green btn-hero-action" onclick="playAll()">
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  <span>Phát tất cả</span>
                </button>
                <button type="button" class="btn btn-outline-white btn-hero-action" onclick="shufflePlay()">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="16 3 21 3 21 8"></polyline>
                    <line x1="4" y1="20" x2="21" y2="3"></line>
                    <polyline points="21 16 21 21 16 21"></polyline>
                    <line x1="15" y1="15" x2="21" y2="21"></line>
                    <line x1="4" y1="4" x2="9" y2="9"></line>
                  </svg>
                  <span>Phát ngẫu nhiên</span>
                </button>
              <% } %>
              <button type="button" class="btn btn-ghost btn-hero-action" onclick="openRenameModal()">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path>
                </svg>
                <span>Đổi tên</span>
              </button>
              <button type="button" class="btn btn-ghost-danger btn-hero-action" onclick="openDeleteModal()">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 6h18"></path>
                  <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
                  <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
                </svg>
                <span>Xóa</span>
              </button>
            </div>
          </div>
        </div>

        <% if (message) { %>
          <div class="app-alert app-alert-success" id="flashMsg">
            <span class="alert-icon">✓</span>
            <span class="alert-text"><%= message %></span>
          </div>
        <% } %>

        <div class="playlist-detail-grid-layout">

          <!-- ══ LEFT / MAIN COLUMN: TRACKS IN PLAYLIST ═══════════ -->
          <div class="playlist-tracks-column">
            <div class="section-title-bar">
              <h2 class="section-heading">Bài hát trong danh sách (<span id="currentPlCount"><%= songs.length %></span>)</h2>
              <span class="section-hint">Kéo thả biểu tượng ⠿ để đổi vị trí</span>
            </div>

            <% if (songs.length === 0) { %>
              <div class="empty-catalog-state" style="padding: 40px 20px;">
                <div class="empty-illustration">🎶</div>
                <h3 class="empty-state-title">Playlist chưa có bài hát nào</h3>
                <p class="empty-state-desc">Hãy chọn thêm bài hát từ danh sách gợi ý bên cạnh!</p>
              </div>
            <% } else { %>
              <div class="playlist-sortable-list" id="sortableList">
                <% songs.forEach(function(song, idx) { %>
                  <div class="track-list-row pl-song-row draggable-track-row" data-id="<%= song.id %>" data-idx="<%= idx %>" draggable="true">
                    <div class="col-drag" title="Kéo để sắp xếp thứ tự">⠿</div>

                    <div class="col-index" onclick="playSong(<%= idx %>)">
                      <span class="index-number"><%= idx + 1 %></span>
                      <span class="row-play-icon">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                      </span>
                      <div class="row-equalizer-anim" aria-hidden="true">
                        <span></span><span></span><span></span><span></span>
                      </div>
                    </div>

                    <div class="col-main" onclick="playSong(<%= idx %>)">
                      <% if (song.image) { %>
                        <img class="row-thumb" src="<%= song.image %>" alt="<%= song.title %>" loading="lazy">
                      <% } else { %>
                        <div class="row-thumb-placeholder">🎵</div>
                      <% } %>
                      <div class="row-title-group">
                        <span class="row-title" title="<%= song.title %>"><%= song.title %></span>
                        <span class="row-artist" title="<%= song.artist %>"><%= song.artist %></span>
                      </div>
                    </div>

                    <div class="col-actions">
                      <button type="button" class="row-action-btn like-btn" onclick="toggleCardLike(this, <%= song.id %>)" title="Yêu thích">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
                        </svg>
                      </button>
                      <button type="button" class="row-action-btn remove-btn" onclick="removeSongFromPl(<%= song.id %>, this)" title="Xóa khỏi playlist" aria-label="Xóa khỏi playlist">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <line x1="18" y1="6" x2="6" y2="18"></line>
                          <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                      </button>
                    </div>
                  </div>
                <% }); %>
              </div>
            <% } %>
          </div>

          <!-- ══ RIGHT / SIDE COLUMN: ADD SONGS CATALOG ═══════════ -->
          <div class="playlist-add-column">
            <div class="add-section-panel">
              <div class="add-panel-header">
                <h3 class="add-panel-title">Thêm bài hát</h3>
                <p class="add-panel-subtitle">Tìm và thêm bài hát vào danh sách phát này</p>
                <div class="add-search-input-wrap">
                  <span class="search-icon">🔍</span>
                  <input type="text" id="addSearchInput" placeholder="Tìm theo tên bài hát, ca sĩ..." oninput="filterCandidateSongs(this.value)">
                </div>
              </div>

              <div class="candidate-songs-scroll-box" id="candidateList">
                <% if (notInPlaylist.length === 0) { %>
                  <div class="empty-candidate-hint">Tất cả bài hát trong thư viện đã có trong playlist này!</div>
                <% } else { %>
                  <% notInPlaylist.forEach(function(song) { %>
                    <div class="candidate-song-item" data-id="<%= song.id %>" data-title="<%= song.title.toLowerCase() %>" data-artist="<%= song.artist.toLowerCase() %>">
                      <div class="candidate-thumb-box">
                        <% if (song.image) { %>
                          <img src="<%= song.image %>" alt="<%= song.title %>" loading="lazy">
                        <% } else { %>
                          <span>🎵</span>
                        <% } %>
                      </div>
                      <div class="candidate-info-box">
                        <span class="candidate-title" title="<%= song.title %>"><%= song.title %></span>
                        <span class="candidate-artist" title="<%= song.artist %>"><%= song.artist %></span>
                      </div>
                      <button type="button" class="btn btn-sm btn-outline-green btn-candidate-add" onclick="addCandidateToPl(<%= song.id %>, '<%= song.title.replace(/'/g, "\\'") %>', this)">
                        ＋ Thêm
                      </button>
                    </div>
                  <% }); %>
                <% } %>
              </div>
            </div>
          </div>

        </div>

        <%- include('partials/footer', { settings }) %>
      </main>
    </div>
  </div>

  <!-- Rename Modal -->
  <div class="app-modal-overlay" id="renameModal" role="dialog" aria-modal="true">
    <div class="app-modal-box">
      <div class="modal-header">
        <h3 class="modal-title">✏️ Đổi tên playlist</h3>
        <button type="button" class="modal-close-btn" onclick="closeModal('renameModal')">✕</button>
      </div>
      <form action="/playlists/<%= playlist.id %>/rename" method="POST">
        <div class="modal-body">
          <div class="form-group-field">
            <label for="renameInput">Tên mới cho playlist</label>
            <input type="text" name="name" id="renameInput" value="<%= playlist.name %>" maxlength="80" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-ghost" onclick="closeModal('renameModal')">Hủy</button>
          <button type="submit" class="btn btn-green">Lưu</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Delete Modal -->
  <div class="app-modal-overlay" id="deleteModal" role="dialog" aria-modal="true">
    <div class="app-modal-box">
      <div class="modal-header">
        <h3 class="modal-title">🗑️ Xác nhận xóa playlist</h3>
        <button type="button" class="modal-close-btn" onclick="closeModal('deleteModal')">✕</button>
      </div>
      <form action="/playlists/<%= playlist.id %>/delete" method="POST">
        <div class="modal-body">
          <p class="modal-warning-text">
            Bạn có chắc chắn muốn xóa playlist <strong>"<%= playlist.name %>"</strong>? Hành động này không thể hoàn tác.
          </p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-ghost" onclick="closeModal('deleteModal')">Hủy</button>
          <button type="submit" class="btn btn-danger">Xóa vĩnh viễn</button>
        </div>
      </form>
    </div>
  </div>

  <%- include('partials/player') %>
  <%- include('partials/mobile_nav', { user, activeNav: 'playlists' }) %>

  <script>
    const PLAYLIST_ID = <%= playlist.id %>;
    window.SONGS = <%- JSON.stringify(songs.map(s => ({
      id:       s.id,
      title:    s.title,
      artist:   s.artist,
      album:    s.album || '',
      image:    s.image || '',
      src:      s.music_file,
      isHot:    Number(s.is_hot) === 1,
      hotLabel: s.hot_label || 'HOT'
    }))) %>;

    function playAll() {
      if (window.SONGS && window.SONGS.length > 0) playSong(0);
    }

    function shufflePlay() {
      if (window.SONGS && window.SONGS.length > 0) {
        var randIdx = Math.floor(Math.random() * window.SONGS.length);
        playSong(randIdx);
      }
    }

    function openRenameModal() {
      var modal = document.getElementById('renameModal');
      modal.classList.add('open');
      setTimeout(function() { document.getElementById('renameInput').focus(); }, 100);
    }

    function openDeleteModal() {
      document.getElementById('deleteModal').classList.add('open');
    }

    function closeModal(id) {
      document.getElementById(id).classList.remove('open');
    }

    // Lọc bài hát candidate
    function filterCandidateSongs(q) {
      var term = (q || '').trim().toLowerCase();
      document.querySelectorAll('.candidate-song-item').forEach(function(item) {
        var t = item.dataset.title;
        var a = item.dataset.artist;
        if (!term || t.includes(term) || a.includes(term)) {
          item.style.display = '';
        } else {
          item.style.display = 'none';
        }
      });
    }

    // Thêm candidate vào playlist qua AJAX
    function addCandidateToPl(songId, songTitle, btn) {
      btn.disabled = true;
      btn.textContent = '...';

      fetch('/playlists/' + PLAYLIST_ID + '/add-song', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: 'songId=' + encodeURIComponent(songId)
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.ok) {
          btn.textContent = '✓ Đã thêm';
          btn.classList.remove('btn-outline-green');
          btn.classList.add('btn-secondary');
          showToast('✅ Đã thêm "' + songTitle + '" vào danh sách!');
          setTimeout(function() { location.reload(); }, 600);
        } else {
          btn.disabled = false;
          btn.textContent = '＋ Thêm';
          showToast('⚠️ ' + (data.message || 'Không thể thêm bài'), true);
        }
      })
      .catch(function() {
        btn.disabled = false;
        btn.textContent = '＋ Thêm';
        showToast('⚠️ Lỗi kết nối máy chủ', true);
      });
    }

    // Xóa bài hát khỏi playlist qua AJAX
    function removeSongFromPl(songId, btn) {
      if (!confirm('Bạn có chắc muốn xóa bài này khỏi danh sách phát?')) return;
      var row = btn.closest('.track-list-row');
      if (row) row.style.opacity = '0.3';

      fetch('/playlists/' + PLAYLIST_ID + '/remove-song', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: 'songId=' + encodeURIComponent(songId)
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.ok) {
          if (row) row.remove();
          showToast('Đã xóa bài khỏi danh sách phát.');
          setTimeout(function() { location.reload(); }, 500);
        } else {
          if (row) row.style.opacity = '1';
          showToast('⚠️ Không thể xóa bài hát', true);
        }
      })
      .catch(function() {
        if (row) row.style.opacity = '1';
      });
    }

    // Drag and drop reordering
    (function initDragAndDrop() {
      var list = document.getElementById('sortableList');
      if (!list) return;
      var dragged = null;

      list.addEventListener('dragstart', function(e) {
        dragged = e.target.closest('.draggable-track-row');
        if (dragged) {
          e.dataTransfer.effectAllowed = 'move';
          dragged.classList.add('dragging');
        }
      });

      list.addEventListener('dragover', function(e) {
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
        var target = e.target.closest('.draggable-track-row');
        if (target && target !== dragged) {
          var rect = target.getBoundingClientRect();
          var mid = rect.top + rect.height / 2;
          if (e.clientY < mid) {
            list.insertBefore(dragged, target);
          } else {
            list.insertBefore(dragged, target.nextSibling);
          }
        }
      });

      list.addEventListener('dragend', function() {
        if (dragged) {
          dragged.classList.remove('dragging');
          dragged = null;
          saveNewOrder();
        }
      });

      function saveNewOrder() {
        var rows = list.querySelectorAll('.draggable-track-row');
        var songIds = Array.from(rows).map(function(r) { return r.dataset.id; });
        // Cập nhật lại số thứ tự trên UI
        rows.forEach(function(r, idx) {
          var num = r.querySelector('.index-number');
          if (num) num.textContent = idx + 1;
          r.dataset.idx = idx;
        });

        fetch('/playlists/' + PLAYLIST_ID + '/reorder', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ songIds: songIds })
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
          if (res.ok) showToast('Đã lưu thứ tự mới ✓');
        });
      }
    })();
  </script>
  <script src="/js/player.js?v=4.0"></script>
  <script src="/js/playlist.js?v=4.0"></script>
  <script src="/js/search.js?v=4.0"></script>
</body>
</html>
