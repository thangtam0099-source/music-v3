<!DOCTYPE html>
<html lang="vi" data-theme="dark">
<head>
  <%- include('partials/head') %>
  <title>Bài hát đã yêu thích — Tâm Music</title>
</head>
<body class="app-body" <% if (settings && settings.background) { %> style="--custom-bg: url('<%= settings.background %>');" <% } %>>

  <div class="app-layout">
    <%- include('partials/sidebar', { user, settings, activeNav: 'favorites' }) %>

    <div class="app-main-viewport">
      <%- include('partials/header', { user, settings }) %>

      <main class="main-content" id="mainContent" role="main">

        <!-- Breadcrumb -->
        <nav class="app-breadcrumb" aria-label="Đường dẫn trang">
          <a href="/">Trang chủ</a>
          <span class="sep">/</span>
          <span class="current">Bài hát yêu thích</span>
        </nav>

        <!-- Favorites Hero Section -->
        <div class="detail-hero-card">
          <div class="detail-hero-cover-wrap favorite-hero-cover" style="background: linear-gradient(135deg, #f43f5e 0%, #be123c 100%); display: flex; align-items: center; justify-content: center; box-shadow: 0 10px 28px rgba(244, 63, 94, 0.35);">
            <svg viewBox="0 0 24 24" fill="#ffffff" style="width: 76px; height: 76px;">
              <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
            </svg>
          </div>

          <div class="detail-hero-info">
            <span class="detail-type-badge" style="color: #f43f5e; font-weight: 800;">Tuyển tập cá nhân</span>
            <h1 class="detail-title">Bài hát đã yêu thích</h1>
            <p class="detail-description">Những giai điệu bạn đã lưu và yêu thích nhất, phát liên tục và thưởng thức bất cứ lúc nào.</p>
            <div class="detail-meta-row">
              <span class="detail-stat"><strong id="favTotalCount">0</strong> bài hát</span>
              <span class="meta-dot">·</span>
              <span class="detail-stat">Tâm Music Yêu Thích</span>
            </div>

            <div class="detail-action-buttons" id="favActionButtons" style="display: none;">
              <button type="button" class="btn btn-green btn-hero-action" onclick="playAllFavorites()">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7z"/>
                </svg>
                <span>Phát tất cả</span>
              </button>
              <button type="button" class="btn btn-outline-white btn-hero-action" onclick="shuffleFavorites()">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="16 3 21 3 21 8"></polyline>
                  <line x1="4" y1="20" x2="21" y2="3"></line>
                  <polyline points="21 16 21 21 16 21"></polyline>
                  <line x1="15" y1="15" x2="21" y2="21"></line>
                  <line x1="4" y1="4" x2="9" y2="9"></line>
                </svg>
                <span>Phát ngẫu nhiên</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Tracklist or Empty State -->
        <section class="detail-tracklist-section">
          <!-- Empty State -->
          <div class="empty-catalog-state" id="favEmptyState" style="display: none;">
            <div class="empty-illustration">❤️</div>
            <h3 class="empty-state-title">Chưa có bài hát yêu thích nào</h3>
            <p class="empty-state-desc">Hãy bấm vào biểu tượng trái tim ở bất kỳ bài hát nào để lưu vào danh sách yêu thích của bạn.</p>
            <a href="/" class="btn btn-primary btn-sm" style="margin-top: 14px;">← Khám phá bài hát ngay</a>
          </div>

          <!-- Table Container -->
          <div class="detail-songs-table" id="favSongsTable" style="display: none;">
            <div class="table-header-row">
              <span class="col-index">#</span>
              <span class="col-main">Tiêu đề</span>
              <span class="col-album">Album</span>
              <span class="col-actions">Hành động</span>
            </div>
            <div id="favRowsList"></div>
          </div>
        </section>

        <%- include('partials/footer', { settings }) %>
      </main>
    </div>
  </div>

  <%- include('partials/player') %>
  <%- include('partials/mobile_nav', { user, activeNav: 'favorites' }) %>

  <!-- Catalog Data Injection -->
  <script>
    window.RAW_CATALOG = <%- JSON.stringify(songs.map(s => ({
      id:       s.id,
      title:    s.title,
      artist:   s.artist,
      album:    s.album || '',
      image:    s.image || '',
      src:      s.music_file,
      isHot:    Number(s.is_hot) === 1,
      hotLabel: s.hot_label || 'HOT'
    }))) %>;
  </script>
  <script src="/js/player.js?v=4.1"></script>
  <script src="/js/playlist.js?v=4.1"></script>
  <script src="/js/search.js?v=4.1"></script>

  <script>
    (function() {
      function renderFavorites() {
        const rawCatalog = window.RAW_CATALOG || [];
        let likedIds = [];
        try {
          likedIds = JSON.parse(localStorage.getItem('tam_music_likes') || '[]');
          if (!Array.isArray(likedIds)) likedIds = [];
        } catch(e) {
          likedIds = [];
        }

        const likedSet = new Set(likedIds.map(Number));
        const filtered = rawCatalog.filter(s => likedSet.has(Number(s.id)));

        // Update global SONGS for player playback
        window.SONGS = filtered;

        const countEl = document.getElementById('favTotalCount');
        const actionsEl = document.getElementById('favActionButtons');
        const emptyEl = document.getElementById('favEmptyState');
        const tableEl = document.getElementById('favSongsTable');
        const listEl = document.getElementById('favRowsList');

        if (countEl) countEl.textContent = filtered.length;

        if (!filtered.length) {
          if (actionsEl) actionsEl.style.display = 'none';
          if (tableEl) tableEl.style.display = 'none';
          if (emptyEl) emptyEl.style.display = 'block';
          if (listEl) listEl.innerHTML = '';
          return;
        }

        if (actionsEl) actionsEl.style.display = 'flex';
        if (tableEl) tableEl.style.display = 'flex';
        if (emptyEl) emptyEl.style.display = 'none';

        if (listEl) {
          listEl.innerHTML = filtered.map((song, idx) => `
            <div class="track-list-row pl-song-row" data-song-id="${song.id}" data-idx="${idx}" onclick="playSong(${idx})">
              <div class="col-index">
                <span class="index-number">${idx + 1}</span>
                <span class="row-play-icon">
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </span>
                <div class="row-equalizer-anim" aria-hidden="true">
                  <span></span><span></span><span></span><span></span>
                </div>
              </div>

              <div class="col-main">
                ${song.image ? `<img class="row-thumb" src="${song.image}" alt="${song.title}" loading="lazy">` : `<div class="row-thumb-placeholder">🎵</div>`}
                <div class="row-title-group">
                  <span class="row-title" title="${song.title}">${song.title}</span>
                  <span class="row-artist" title="${song.artist}">${song.artist}</span>
                </div>
              </div>

              <div class="col-album">
                <span class="row-album-text" title="${song.album || ''}">${song.album || '—'}</span>
              </div>

              <div class="col-actions" onclick="event.stopPropagation()">
                <button type="button" class="row-action-btn like-btn active" onclick="removeFromFavoritesPage(${song.id})" title="Bỏ yêu thích" aria-label="Bỏ yêu thích">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
                  </svg>
                </button>
                <button type="button" class="row-action-btn playlist-btn" onclick="togglePlaylistPopup(this, ${song.id}, '${song.title.replace(/'/g, "\\'")}')" title="Thêm vào playlist" aria-label="Thêm vào playlist">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
            </div>
          `).join('');
        }
      }

      window.removeFromFavoritesPage = function(songId) {
        if (typeof window.toggleCardLike === 'function') {
          window.toggleCardLike(document.createElement('div'), songId);
        }
        renderFavorites();
      };

      window.playAllFavorites = function() {
        if (!window.SONGS || !window.SONGS.length) {
          if (typeof window.showToast === 'function') window.showToast('Danh sách bài hát yêu thích trống', true);
          return;
        }
        if (typeof window.playAll === 'function') {
          window.playAll();
        }
      };

      window.shuffleFavorites = function() {
        if (!window.SONGS || !window.SONGS.length) {
          if (typeof window.showToast === 'function') window.showToast('Danh sách bài hát yêu thích trống', true);
          return;
        }
        if (typeof window.shufflePlay === 'function') {
          window.shufflePlay();
        }
      };

      // Initial render on DOM load
      document.addEventListener('DOMContentLoaded', renderFavorites);
      // In case PJAX/SPA or script executed after DOMContentLoaded
      renderFavorites();
    })();
  </script>
</body>
</html>
