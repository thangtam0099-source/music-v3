<!DOCTYPE html>
<html lang="vi" data-theme="dark">
<head>
  <%- include('partials/head') %>
  <title>Playlist của tôi — Tâm Music</title>
</head>
<body class="app-body" <% if (settings && settings.background) { %> style="--custom-bg: url('<%= settings.background %>');" <% } %>>

  <div class="app-layout">
    <%- include('partials/sidebar', { user, settings, activeNav: 'playlists' }) %>

    <div class="app-main-viewport">
      <%- include('partials/header', { user, settings }) %>

      <main class="main-content" id="mainContent" role="main">

        <div class="page-title-banner playlists-title-banner">
          <div class="page-title-group">
            <h1 class="page-main-heading">Playlist của tôi</h1>
          </div>
          <button type="button" class="btn btn-green" onclick="openModal('createModal')">
            <span>Tạo playlist mới</span>
          </button>
        </div>

        <% if (message) { %>
          <div class="app-alert app-alert-success" id="flashMsg">
            <span class="alert-text"><%= message %></span>
          </div>
        <% } %>

        <% if (playlists.length === 0) { %>
          <div class="empty-catalog-state">
            <h3 class="empty-state-title">Bạn chưa có playlist nào</h3>
            <p class="empty-state-desc">Hãy tạo playlist đầu tiên để lưu lại những bài hát bạn yêu thích nhất!</p>
            <button type="button" class="btn btn-green" onclick="openModal('createModal')" style="margin-top: 14px;">
              Tạo playlist ngay
            </button>
          </div>
        <% } else { %>
          <div class="playlists-card-grid">
            <% playlists.forEach(function(pl) { %>
              <div class="playlist-grid-card">
                <a href="/playlists/<%= pl.id %>" class="playlist-card-link" aria-label="Xem <%= pl.name %>">
                  <div class="playlist-card-cover-wrap<%= pl.coverImg ? '' : ' playlist-cover-empty' %>">
                    <% if (pl.coverImg) { %>
                      <img class="playlist-card-cover" src="<%= pl.coverImg %>" alt="<%= pl.name %>" loading="lazy">
                    <% } %>
                  </div>
                  <div class="playlist-card-info">
                    <h3 class="playlist-card-title" title="<%= pl.name %>"><%= pl.name %></h3>
                    <span class="playlist-card-count"><%= pl.songs.length %> bài hát</span>
                  </div>
                </a>

                <div class="playlist-card-manage-actions">
                  <button type="button" class="pl-mini-btn" data-name="<%= pl.name %>" onclick="openRenameModal(<%= pl.id %>, this.dataset.name)" title="Đổi tên playlist" aria-label="Đổi tên">
                    Đổi tên
                  </button>
                  <button type="button" class="pl-mini-btn danger" data-name="<%= pl.name %>" onclick="openDeleteModal(<%= pl.id %>, this.dataset.name)" title="Xóa playlist" aria-label="Xóa">
                    Xóa
                  </button>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>

        <%- include('partials/footer', { settings }) %>

        <!-- ══ MODALS CHO PLAYLIST ═══════════════════════════════════ -->
        <!-- Tạo playlist mới -->
        <div class="app-modal-overlay" id="createModal" role="dialog" aria-modal="true" aria-labelledby="createModalTitle">
          <div class="app-modal-box">
            <div class="modal-header">
              <h3 class="modal-title" id="createModalTitle">Tạo playlist mới</h3>
              <button type="button" class="modal-close-btn" onclick="closeModal('createModal')" aria-label="Đóng">✕</button>
            </div>
            <form action="/playlists/create" method="POST">
              <div class="modal-body">
                <div class="form-group-field">
                  <label for="createInput">Tên danh sách phát</label>
                  <input type="text" name="name" id="createInput" placeholder="VD: Nhạc thư giãn, Acoustic chill..." maxlength="80" required autofocus>
                </div>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-ghost" onclick="closeModal('createModal')">Hủy</button>
                <button type="submit" class="btn btn-green">Tạo danh sách</button>
              </div>
            </form>
          </div>
        </div>

        <!-- Đổi tên playlist -->
        <div class="app-modal-overlay" id="renameModal" role="dialog" aria-modal="true" aria-labelledby="renameModalTitle">
          <div class="app-modal-box">
            <div class="modal-header">
              <h3 class="modal-title" id="renameModalTitle">Đổi tên playlist</h3>
              <button type="button" class="modal-close-btn" onclick="closeModal('renameModal')" aria-label="Đóng">✕</button>
            </div>
            <form id="renameForm" method="POST">
              <div class="modal-body">
                <div class="form-group-field">
                  <label for="renameInput">Tên mới</label>
                  <input type="text" name="name" id="renameInput" maxlength="80" required>
                </div>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-ghost" onclick="closeModal('renameModal')">Hủy</button>
                <button type="submit" class="btn btn-green">Lưu thay đổi</button>
              </div>
            </form>
          </div>
        </div>

        <!-- Xác nhận xóa playlist -->
        <div class="app-modal-overlay" id="deleteModal" role="dialog" aria-modal="true" aria-labelledby="deleteModalTitle">
          <div class="app-modal-box">
            <div class="modal-header">
              <h3 class="modal-title" id="deleteModalTitle">Xác nhận xóa playlist</h3>
              <button type="button" class="modal-close-btn" onclick="closeModal('deleteModal')" aria-label="Đóng">✕</button>
            </div>
            <form id="deleteForm" method="POST">
              <div class="modal-body">
                <p class="modal-warning-text">
                  Bạn có chắc chắn muốn xóa playlist <strong id="deletePlName"></strong>? Hành động này không thể hoàn tác.
                </p>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-ghost" onclick="closeModal('deleteModal')">Hủy bỏ</button>
                <button type="submit" class="btn btn-danger">Xóa vĩnh viễn</button>
              </div>
            </form>
          </div>
        </div>
      </main>
    </div>
  </div>

  <%- include('partials/player') %>
  <%- include('partials/mobile_nav', { user, activeNav: 'playlists' }) %>

  <script data-playlist-page>
    window.SONGS = [];

    function openModal(id) {
      var modal = document.getElementById(id);
      if (modal) {
        modal.classList.add('open');
        var input = modal.querySelector('input[type="text"]');
        (input || modal.querySelector('.modal-close-btn')).focus();
      }
    }

    function closeModal(id) {
      var modal = document.getElementById(id);
      if (modal) modal.classList.remove('open');
    }

    function openRenameModal(plId, name) {
      document.getElementById('renameForm').action = '/playlists/' + plId + '/rename';
      document.getElementById('renameInput').value = name;
      openModal('renameModal');
    }

    function openDeleteModal(plId, name) {
      document.getElementById('deleteForm').action = '/playlists/' + plId + '/delete';
      document.getElementById('deletePlName').textContent = '“' + name + '”';
      openModal('deleteModal');
    }

    document.querySelectorAll('.app-modal-overlay').forEach(function(overlay) {
      overlay.addEventListener('click', function(e) {
        if (e.target === overlay) overlay.classList.remove('open');
      });
      overlay.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          e.stopPropagation();
          overlay.classList.remove('open');
        }
      });
    });

    setTimeout(function() {
      var flash = document.getElementById('flashMsg');
      if (flash) {
        flash.style.opacity = '0';
        flash.style.transition = 'opacity 0.4s ease';
        setTimeout(function() { flash.remove(); }, 400);
      }
    }, 3200);
  </script>
  <script src="/js/player.js?v=4.7"></script>
  <script src="/js/playlist.js?v=4.0"></script>
  <script src="/js/search.js?v=4.0"></script>
</body>
</html>
