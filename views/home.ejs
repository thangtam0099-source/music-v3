<!DOCTYPE html>
<html lang="vi" data-theme="dark">
<head>
  <%- include('partials/head') %>
  <title>Tâm Music — Nghe nhạc trực tuyến đỉnh cao</title>
</head>
<body class="app-body" <% if (settings && settings.background) { %> style="--custom-bg: url('<%= settings.background %>');" <% } %>>

  <div class="app-layout">
    <!-- Desktop & Tablet Sidebar -->
    <%- include('partials/sidebar', { user, settings, activeNav: 'home' }) %>

    <!-- Main App Container -->
    <div class="app-main-viewport">
      <%- include('partials/header', { user, settings, q, sort }) %>

      <main class="main-content" id="mainContent" role="main">

        <!-- ══ GREETING & HERO BANNER ═════════════════════════ -->
        <section class="home-hero-section">
          <div class="hero-greeting-bar">
            <div class="greeting-text-group">
              <span class="greeting-subtitle" id="timeGreeting">Xin chào</span>
              <h1 class="greeting-title">
                <% if (user) { %>
                  Chào mừng trở lại, <span class="user-highlight"><%= user.username %></span>!
                <% } else { %>
                  Âm nhạc cho tâm hồn bạn
                <% } %>
              </h1>
            </div>
            <% if (songs.length > 0) { %>
              <div class="hero-quick-actions">
                <button type="button" class="btn btn-green btn-play-featured" onclick="shufflePlay()" title="Phát ngẫu nhiên toàn bộ danh sách">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="16 3 21 3 21 8"></polyline>
                    <line x1="4" y1="20" x2="21" y2="3"></line>
                    <polyline points="21 16 21 21 16 21"></polyline>
                    <line x1="15" y1="15" x2="21" y2="21"></line>
                    <line x1="4" y1="4" x2="9" y2="9"></line>
                  </svg>
                  <span>Phát ngẫu nhiên</span>
                </button>
              </div>
            <% } %>
          </div>

          <% if (settings && settings.banner) { %>
            <div class="featured-banner-card">
              <img class="featured-banner-img" src="<%= settings.banner %>" alt="Banner Tâm Music" loading="eager">
              <div class="featured-banner-gradient"></div>
              <div class="featured-banner-content">
                <span class="banner-badge">Tuyển chọn hôm nay</span>
                <h2 class="banner-headline">Giai điệu tuyển chọn chất lượng cao</h2>
                <p class="banner-description">Không gian âm nhạc mượt mà, thư thái, lắng đọng mọi khoảnh khắc.</p>
                <% if (songs.length > 0) { %>
                  <button type="button" class="btn btn-primary btn-sm" onclick="playSong(0)">
                    <svg viewBox="0 0 24 24" fill="currentColor" style="width: 14px; height: 14px;">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                    Nghe bài hát mới nhất
                  </button>
                <% } %>
              </div>
            </div>
          <% } %>
        </section>

        <!-- ══ HOT SONGS SHELF (BÀI HÁT NỔI BẬT) ═══════════════ -->
        <% const hotSongs = songs.filter(s => Number(s.is_hot) === 1); %>
        <% if (hotSongs.length > 0 && !q) { %>
          <section class="music-shelf-section">
            <div class="shelf-header">
              <div class="shelf-title-wrap">
                <span class="shelf-tag">Thịnh hành</span>
                <h2 class="shelf-title">Bài hát nổi bật</h2>
              </div>
              <span class="shelf-counter"><%= hotSongs.length %> bài</span>
            </div>

            <div class="hot-songs-carousel">
              <% hotSongs.slice(0, 6).forEach(function(song) { %>
                <% const originalIdx = songs.findIndex(s => s.id === song.id); %>
                <div class="hot-song-card song-interactive-card" data-song-id="<%= song.id %>" data-idx="<%= originalIdx %>" onclick="playSong(<%= originalIdx %>)">
                  <div class="hot-card-art">
                    <% if (song.image) { %>
                      <img src="<%= song.image %>" alt="<%= song.title %>" loading="lazy">
                    <% } else { %>
                      <div class="art-placeholder-icon">🎵</div>
                    <% } %>
                    <span class="hot-pill"><%= song.hot_label || 'HOT' %></span>
                    <div class="card-equalizer" aria-hidden="true">
                      <span></span><span></span><span></span><span></span>
                    </div>
                  </div>
                  <div class="hot-card-body">
                    <span class="hot-card-title" title="<%= song.title %>"><%= song.title %></span>
                    <span class="hot-card-artist" title="<%= song.artist %>"><%= song.artist %></span>
                  </div>
                </div>
              <% }); %>
            </div>
          </section>
        <% } %>

        <!-- ══ ALBUM COLLECTIONS SHELF ═════════════════════════ -->
        <% if (typeof albums !== 'undefined' && albums.length > 0 && !q) { %>
          <section class="music-shelf-section">
            <div class="shelf-header">
              <div class="shelf-title-wrap">
                <span class="shelf-tag">Bộ sưu tập</span>
                <h2 class="shelf-title">Album & Tuyển tập</h2>
              </div>
              <a href="/albums" class="shelf-view-all">Xem tất cả →</a>
            </div>

            <div class="albums-horizontal-grid">
              <% albums.slice(0, 5).forEach(function(album) { %>
                <a href="/albums/<%= album.id %>" class="album-shelf-card">
                  <div class="album-cover-box">
                    <% if (album.thumbnail) { %>
                      <img src="<%= album.thumbnail %>" alt="<%= album.name %>" loading="lazy">
                    <% } else { %>
                      <div class="album-placeholder-box">💿</div>
                    <% } %>
                  </div>
                  <div class="album-shelf-info">
                    <span class="album-shelf-title"><%= album.name %></span>
                    <span class="album-shelf-meta"><%= album.song_count %> bài hát</span>
                  </div>
                </a>
              <% }); %>
            </div>
          </section>
        <% } %>

        <!-- ══ ALL SONGS CATALOG ═══════════════════════════════ -->
        <section class="music-catalog-section" id="allSongsSection">
          <div class="catalog-header-bar">
            <div class="catalog-title-group">
              <h2 class="catalog-heading">
                <% if (q) { %>
                  Kết quả tìm kiếm cho "<span class="search-highlight"><%= q %></span>"
                <% } else { %>
                  Tất cả bài hát
                <% } %>
              </h2>
              <span class="catalog-count-pill"><%= songs.length %> bài hát</span>
            </div>

            <div class="catalog-controls-group">
              <!-- View mode toggle (Grid vs List) -->
              <div class="view-mode-toggles" role="group" aria-label="Kiểu hiển thị">
                <button type="button" class="view-toggle-btn active" id="viewModeGridBtn" onclick="switchViewMode('grid')" title="Dạng lưới" aria-label="Xem dạng lưới">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="7" height="7" x="3" y="3" rx="1"></rect>
                    <rect width="7" height="7" x="14" y="3" rx="1"></rect>
                    <rect width="7" height="7" x="14" y="14" rx="1"></rect>
                    <rect width="7" height="7" x="3" y="14" rx="1"></rect>
                  </svg>
                </button>
                <button type="button" class="view-toggle-btn" id="viewModeListBtn" onclick="switchViewMode('list')" title="Dạng danh sách" aria-label="Xem dạng danh sách">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="8" y1="6" x2="21" y2="6"></line>
                    <line x1="8" y1="12" x2="21" y2="12"></line>
                    <line x1="8" y1="18" x2="21" y2="18"></line>
                    <line x1="3" y1="6" x2="3.01" y2="6"></line>
                    <line x1="3" y1="12" x2="3.01" y2="12"></line>
                    <line x1="3" y1="18" x2="3.01" y2="18"></line>
                  </svg>
                </button>
              </div>

              <!-- Sorting Pills -->
              <div class="sort-selector-group">
                <a href="/?<%= q ? 'q=' + encodeURIComponent(q) + '&' : '' %>sort=newest"
                   class="sort-pill-btn <%= sort === 'newest' ? 'active' : '' %>">Mới nhất</a>
                <a href="/?<%= q ? 'q=' + encodeURIComponent(q) + '&' : '' %>sort=az"
                   class="sort-pill-btn <%= sort === 'az' ? 'active' : '' %>">A → Z</a>
              </div>
            </div>
          </div>

          <!-- Empty State -->
          <% if (songs.length === 0) { %>
            <div class="empty-catalog-state">
              <div class="empty-illustration">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  <line x1="8" y1="11" x2="14" y2="11"></line>
                </svg>
              </div>
              <h3 class="empty-state-title">
                <%= q ? 'Không tìm thấy bài hát nào phù hợp' : 'Thư viện hiện chưa có bài hát' %>
              </h3>
              <p class="empty-state-desc">
                <%= q ? 'Hãy thử tìm kiếm với từ khóa khác như tên nghệ sĩ hoặc tên bài không dấu.' : 'Vui lòng quay lại sau hoặc liên hệ quản trị viên để tải lên bài hát.' %>
              </p>
              <% if (q) { %>
                <a href="/" class="btn btn-primary btn-sm" style="margin-top: 12px;">← Xem tất cả bài hát</a>
              <% } %>
            </div>
          <% } %>

          <!-- Songs Grid Container -->
          <div class="songs-display-container view-grid" id="songsContainer">
            <% songs.forEach(function(song, idx) { %>
              <div class="song-card song-interactive-card" data-song-id="<%= song.id %>" data-idx="<%= idx %>" data-title="<%= song.title %>" data-artist="<%= song.artist %>">

                <div class="song-card-media" onclick="playSong(<%= idx %>)">
                  <% if (song.image) { %>
                    <img class="song-card-thumb" src="<%= song.image %>" alt="<%= song.title %>" loading="lazy">
                  <% } else { %>
                    <div class="song-card-placeholder">🎵</div>
                  <% } %>

                  <% if (Number(song.is_hot)) { %>
                    <span class="song-hot-badge"><%= song.hot_label || 'HOT' %></span>
                  <% } %>

                  <!-- Equalizer animation when playing -->
                  <div class="song-playing-anim" aria-hidden="true">
                    <span></span><span></span><span></span><span></span>
                  </div>
                </div>

                <div class="song-card-details">
                  <div class="song-card-title-row">
                    <span class="song-card-name" onclick="playSong(<%= idx %>)" title="<%= song.title %>"><%= song.title %></span>
                  </div>
                  <span class="song-card-artist" onclick="playSong(<%= idx %>)" title="<%= song.artist %>"><%= song.artist %></span>
                  <% if (song.album) { %>
                    <span class="song-card-album" title="<%= song.album %>"><%= song.album %></span>
                  <% } %>
                </div>

                <div class="song-card-footer-actions">
                  <button type="button" class="card-icon-action card-like-btn" onclick="toggleCardLike(this, <%= song.id %>)" title="Yêu thích" aria-label="Yêu thích bài hát">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
                    </svg>
                  </button>
                  <button type="button" class="card-icon-action card-playlist-btn" onclick="togglePlaylistPopup(this, <%= song.id %>, '<%= song.title.replace(/'/g, "\\'") %>')" title="Thêm vào playlist" aria-label="Thêm vào playlist">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="12" y1="5" x2="12" y2="19"></line>
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                  </button>
                </div>

              </div>
            <% }); %>
          </div>

        </section>

        <%- include('partials/footer', { settings }) %>
      </main>
    </div>
  </div>

  <!-- Persistent Player Components -->
  <%- include('partials/player') %>

  <!-- Mobile Bottom Navigation -->
  <%- include('partials/mobile_nav', { user, activeNav: 'home' }) %>

  <!-- ══ SONG DATA (SERVER INJECTED) ═══════════════════════════ -->
  <script>
    window.SONGS = <%- JSON.stringify(songs.map(s => ({
      id:       s.id,
      title:    s.title,
      artist:   s.artist,
      album:    s.album || '',
      image:    s.image || '',
      src:      s.music_file,
      isHot:    Number(s.is_hot) === 1,
      hotLabel: s.hot_label || 'HOT'
    }))) %>;
  </script>
  <script src="/js/player.js?v=4.0"></script>
  <script src="/js/playlist.js?v=4.0"></script>
  <script src="/js/search.js?v=4.0"></script>
</body>
</html>
