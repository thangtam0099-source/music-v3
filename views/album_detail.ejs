<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= album.name %> — Tâm Music</title>
  <link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="/css/playlist.css">
</head>
<body <% if (settings.background) { %> style="background-image:url('<%= settings.background %>');background-size:cover;background-attachment:fixed;" <% } %>>
<header class="site-header"><div class="header-inner">
  <a class="logo" href="/"><% if (settings.logo) { %><img src="<%= settings.logo %>" alt="Logo"><% } else { %><span>🎵</span><% } %><span>Tâm Music</span></a>
  <nav class="main-nav"><a href="/" class="nav-pill">Trang chủ</a><a href="/albums" class="nav-pill active">Album</a><a href="/playlists" class="nav-pill">Playlist</a></nav>
  <div class="header-actions"><% if (user) { %><div class="user-badge">👤 <span><%= user.username %></span></div><a href="/logout" class="btn btn-secondary btn-sm">Đăng xuất</a><% } else { %><a href="/login" class="btn btn-secondary btn-sm">Đăng nhập</a><% } %></div>
</div></header>
<main class="main-content" style="padding-bottom:120px"><div class="breadcrumb"><a href="/albums">Album</a><span>›</span><span><%= album.name %></span></div>
<div class="pl-hero album-hero"><div class="pl-hero-cover"><% if (album.thumbnail) { %><img src="<%= album.thumbnail %>" alt="<%= album.name %>"><% } else { %><div class="pl-hero-placeholder">💿</div><% } %></div><div class="pl-hero-info"><div class="pl-hero-label">Album</div><h1 class="pl-hero-title"><%= album.name %></h1><div class="pl-hero-meta"><%= songs.length %> bài hát<% if (album.description) { %> · <%= album.description %><% } %></div><div class="pl-hero-actions"><% if (songs.length) { %><button class="btn btn-green" onclick="playAll()">▶ Phát tất cả</button><button class="btn btn-outline" onclick="shufflePlay()">🔀 Ngẫu nhiên</button><% } %></div></div></div>
<div class="pl-song-section"><div class="section-header"><h3>🎵 Danh sách bài (<%= songs.length %>)</h3></div><div class="pl-song-list album-song-list"><% songs.forEach(function(song, idx) { %><div class="pl-song-row" data-idx="<%= idx %>" onclick="playSong(<%= idx %>)"><div class="pl-song-num"><span class="num-label"><%= idx + 1 %></span><span class="play-label">▶</span></div><% if (song.image) { %><img class="thumb-sm" src="<%= song.image %>" alt=""><% } else { %><div class="thumb-placeholder">🎵</div><% } %><div class="pl-song-meta"><div class="pl-song-title"><%= song.title %></div><div class="pl-song-artist"><%= song.artist %></div></div><div class="pl-song-album"><%= song.album || '' %></div><span class="song-playing-indicator" aria-hidden="true"><span class="song-equalizer"><i></i><i></i><i></i><i></i><i></i></span></span></div><% }) %></div></div>
</main>
<%- include('partials/footer', { settings }) %>
<div class="player-bar" id="playerBar"><div class="player-inner"><div class="player-info"><div id="playerCoverWrap"></div><div class="player-meta"><div class="title" id="playerTitle">—</div><div class="artist" id="playerArtist">—</div></div></div><div class="player-controls"><div class="control-buttons"><button class="ctrl-btn" onclick="prevSong()" title="Bài trước">◀</button><button class="ctrl-btn repeat-btn" onclick="toggleRepeat()" title="Lặp lại">↻</button><button class="ctrl-btn play-pause" id="playPauseBtn" onclick="togglePlay()"><svg id="playIcon" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></button><button class="ctrl-btn" onclick="nextSong()" title="Bài tiếp">▶</button></div><div class="progress-area"><span class="time-label" id="currentTime">0:00</span><input type="range" id="progressBar" min="0" max="100" value="0" oninput="seekTo(this.value)"><span class="time-label right" id="totalTime">0:00</span></div></div><div class="player-right"><div class="volume-area"><span class="vol-icon">🔊</span><input type="range" id="volumeBar" min="0" max="1" step="0.01" value="1" oninput="setVolume(this.value)"></div></div></div></div><audio id="audioPlayer" preload="metadata"></audio>
<script>const SONGS = <%- JSON.stringify(songs.map(s => ({ id:s.id,title:s.title,artist:s.artist,album:s.album||'',image:s.image||'',src:s.music_file }))) %>; function playAll(){if(SONGS.length)playSong(0)} function shufflePlay(){if(SONGS.length)playSong(Math.floor(Math.random()*SONGS.length))}</script><script src="/js/player.js"></script>
</body></html>
